{
  "name": "eris",
  "version": "1.1.3",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "check": "tsc --noEmit && echo ✔ Ok",
    "build": "tsc",
    "dev": "bun --env-file .env ./src/index.ts",
    "dev:dev": "bun --env-file .env.dev ./src/index.ts",
    "watch": "bun --watch --env-file .env ./src/index.ts",
    "watch:dev": "bun --hot --env-file .env.dev ./src/index.ts",
    "start": "node --env-file .env ./build/index.js",
    "start:dev": "node --env-file .env.dev ."
  },
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "10.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@google/generative-ai": "^0.24.1",
    "@magicyan/discord": "^1.4.11",
    "@napi-rs/canvas": "^0.1.76",
    "@prisma/client": "^6.13.0",
    "@reliverse/reglob": "1.0.0",
    "axios": "^1.11.0",
    "chalk": "5.4.1",
    "discord.js": "14.21.0",
    "fastify": "^5.5.0",
    "http-status-codes": "2.3.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "node-cache": "^5.1.2",
    "prisma": "^6.13.0",
    "rou3": "0.5.1",
    "systeminformation": "^5.27.7",
    "uuid": "^11.1.0",
    "ws": "^8.18.3",
    "zod": "4.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.2.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ws": "^8.18.1",
    "tsup": "^8.3.5",
    "typescript": "5.7.2"
  },
  "imports": {
    "#database": [
      "./build/database/index.js"
    ],
    "#base": [
      "./build/discord/base/index.js"
    ],
    "#functions": [
      "./build/functions/index.js"
    ],
    "#menus": [
      "./build/menus/index.js"
    ],
    "#settings": [
      "./build/settings/index.js"
    ],
    "#tools": [
      "./build/tools/index.js"
    ],
    "#server": [
      "./build/server/index.js"
    ],
    "#lib": [
      "./build/lib/index.js"
    ],
    "#prisma": [
      "./prisma/prisma/client.js"
    ],
    "#asPrisma": [
      "./prisma/erishelper/client.js"
    ],
    "#dzonePrisma": [
      "./prisma/devzone/client.js"
    ]
  },
  "baseVersion": "1.3.7"
}
