{
  "name": "erisbot",
  "version": "1.0.0",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "check": "tsc --noEmit && echo ✔ Ok",
    "build": "tsc",
    "dev": "bun ./src/index.ts",
    "dev:dev": "bun --env-file .env.dev ./src/index.ts",
    "watch": "bun --hot ./src/index.ts",
    "watch:dev": "bun --watch --env-file .env.dev ./src/index.ts",
    "start": "node --env-file .env .",
    "start:dev": "bun --env-file .env.dev ."
  },
  "dependencies": {
    "@google/genai": "^1.11.0",
    "@google/generative-ai": "^0.24.1",
    "@magicyan/discord": "^1.5.1",
    "@napi-rs/canvas": "^0.1.74",
    "@prisma/client": "^6.12.0",
    "axios": "^1.11.0",
    "chalk": "^5.4.1",
    "discord.js": "^14.21.0",
    "fast-glob": "^3.3.3",
    "node-cache": "^5.1.2",
    "prisma": "^6.12.0",
    "rou3": "^0.7.3",
    "systeminformation": "^5.27.7",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "imports": {
    "#database": [
      "./build/database/index.js"
    ],
    "#base": [
      "./build/discord/base/index.js"
    ],
    "#functions": [
      "./build/functions/index.js"
    ],
    "#menus": [
      "./build/menus/index.js"
    ],
    "#settings": [
      "./build/settings/index.js"
    ],
    "#tools": [
      "./build/tools/index.js"
    ],
    "#server": [
      "./build/server/index.js"
    ],
    "#lib": [
      "./build/lib/index.js"
    ],
    "#utils": [
      "./build/utils/index.js"
    ],
    "#prisma/client": [
      "./prisma/prisma/client.js"
    ],
    "#prisma": [
      "./prisma/prisma/client.js"
    ],
    "#logic": [
      "./build/logic/index.js"
    ]
  },
  "baseVersion": "1.2.6"
}
