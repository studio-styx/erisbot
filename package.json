{
  "name": "eris-canary",
  "version": "1.0.3",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "check": "tsc --noEmit && echo ✔ Ok",
    "build": "tsc",
    "dev": "bun --env-file .env ./src/index.ts",
    "dev:dev": "bun --env-file .env.dev ./src/index.ts",
    "watch": "bun --watch --env-file .env ./src/index.ts",
    "watch:dev": "bun --watch --env-file .env.dev ./src/index.ts",
    "start": "node --env-file .env ./dist/index.js",
    "start:dev": "node --env-file .env.dev ./dist/index.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@magicyan/discord": "1.4.11",
    "@napi-rs/canvas": "^0.1.74",
    "@prisma/client": "^6.13.0",
    "@reliverse/reglob": "1.0.0",
    "axios": "^1.11.0",
    "chalk": "5.4.1",
    "discord.js": "14.21.0",
    "node-cache": "^5.1.2",
    "prisma": "^6.13.0",
    "rou3": "0.5.1",
    "systeminformation": "^5.27.7",
    "zod": "4.0.2"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "@types/bun": "^1.2.10"
  },
  "imports": {
    "#database": [
      "./dist/database/index.js"
    ],
    "#base": [
      "./dist/discord/base/index.js"
    ],
    "#functions": [
      "./dist/functions/index.js"
    ],
    "#menus": [
      "./dist/menus/index.js"
    ],
    "#settings": [
      "./dist/settings/index.js"
    ],
    "#tools": [
      "./dist/tools/index.js"
    ],
    "#server": [
      "./dist/server/index.js"
    ],
    "#lib": [
      "./dist/lib/index.js"
    ],
    "#prisma": [
      "./prisma/prisma/client.js"
    ]
  },
  "baseVersion": "1.3.7"
}